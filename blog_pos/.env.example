# ============================================
# WELTO POS — modèle de configuration
# Développement : copier en blog_pos/.env
# Production (Coolify) : saisir ces variables dans l'onglet « Environment Variables »
# NE JAMAIS committer le vrai .env.
# ============================================

# --- Sécurité ---
# Production : valeur longue et aléatoire, obligatoire.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True uniquement en développement.
DEBUG=True

# Domaine(s) de la boutique, séparés par des virgules (production).
#   ALLOWED_HOSTS=caisse.maboutique.com
#   CSRF_TRUSTED_ORIGINS=https://caisse.maboutique.com
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# true en production derrière HTTPS (Coolify + Cloudflare) : cookies sécurisés.
WELTO_HTTPS=False

# --- Base de données ---
# Vide = SQLite locale (développement). Production : URL PostgreSQL fournie par Coolify.
#   DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/welto
DATABASE_URL=

# --- Dossier des données (logo, signature, logs) ---
# En Docker : /data (volume persistant). Vide en développement.
WELTO_USER_DATA=

# --- Localisation ---
LANGUAGE_CODE=fr-fr
# Guinée : Africa/Conakry — Gambie : Africa/Banjul (tous deux UTC+0)
TIME_ZONE=Africa/Conakry
# Devise par défaut avant la configuration initiale (modifiable dans Paramètres).
CURRENCY=GNF

# --- Serveur (Docker) ---
# Nombre de processus uvicorn. 2 suffit pour une boutique ; 1 Go de RAM ≈ 4 max.
WEB_CONCURRENCY=2

# --- Email (récupération de mot de passe par code) ---
# Vide en développement : les emails s'affichent dans la console.
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_HOST_USER=votreadresse@gmail.com
#   EMAIL_HOST_PASSWORD=mot_de_passe_application
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WELTO <no-reply@welto.app>
